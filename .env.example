# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Auth (defaults shown)
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=30
# true: trust X-Forwarded-For from any proxy; loopback: only from a proxy on this machine
TRUST_PROXY=false
# Secure (__Host-) cookies and HSTS. auto = on when NODE_ENV=production; false only for plain-http installs
COOKIE_SECURE=auto
# Expense attachments (PDF, JPG, PNG). Must not be inside any directory a web server serves.
ATTACHMENTS_DIR=data/attachments
ATTACHMENT_MAX_MB=10
# Bill uploads per user per hour (in memory, per server process)
ATTACHMENT_UPLOADS_PER_HOUR=120
# MariaDB 10.11+ (MariaDB only)
DATABASE_URL=mysql://boq:change-me@127.0.0.1:3306/boq
# Tests only: a server URL with no database name. Each test run creates and drops its own database.
# TEST_DATABASE_URL=mysql://boq:change-me@127.0.0.1:3306
