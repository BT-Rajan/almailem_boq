{
  "name": "@boq/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:rollback": "tsx src/db/cli.ts rollback",
    "db:status": "tsx src/db/cli.ts status",
    "db:seed": "tsx src/db/cli.ts seed",
    "admin:bootstrap": "tsx src/cli/bootstrap-admin.ts"
  },
  "dependencies": {
    "@boq/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.0",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.0.0",
    "mysql2": "^3.24.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
